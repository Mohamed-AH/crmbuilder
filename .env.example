# CRM Builder environment — copy to .env values in your host's dashboard.
# Everything is optional: with nothing set, the app runs in local/dev mode
# (file storage, dev email login, data still fully usable offline).

# Port to listen on (Render sets this automatically)
PORT=8321

# Public URL of the deployed app — REQUIRED in production for OAuth redirects
# e.g. https://crmbuilder.onrender.com
APP_URL=

# MongoDB connection string (MongoDB Atlas free tier works)
# e.g. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=crmbuilder

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret for signing session cookies — set a long random string in production
SESSION_SECRET=

# Comma-separated emails that get the admin role on sign-in
# (the very first account to sign up is also made admin automatically)
ADMIN_EMAILS=

# Set to 1 to allow passwordless email login (for demos; avoid in production)
ALLOW_DEV_LOGIN=

# How long analytics events are kept before MongoDB expires them (default 90).
# The admin dashboard only reads 30 days back; this stops the events collection
# growing without bound and eating the storage quota.
EVENT_RETENTION_DAYS=90
